# Real, local AI (default). Requires Ollama running with the model pulled.
VITE_AI_PROVIDER=gemma-ollama
# gemma4:e2b for weak machines, gemma4:26b for stronger vision (needs ~20+ GB memory)
VITE_GEMMA_MODEL=gemma4:e4b
# Only needed if Ollama is not on localhost:11434 (read by vite.config.js)
# OLLAMA_HOST=http://localhost:11434
# Sample-data mode for UI work without a model:
# VITE_AI_PROVIDER=mock
